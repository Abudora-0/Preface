# ---------------------------------------------------------------------------
# All of these are optional. Preface works with none of them set: the analyzer,
# editor, preview, badges and templates all run locally.
# ---------------------------------------------------------------------------

# Which provider powers the optional "Generate" pass.
# Leave unset to use Ollama, or set to "anthropic" to force Claude.
AI_PROVIDER=

# Local Ollama. Defaults shown; set OLLAMA_MODEL to a model you have pulled.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Only needed if you set AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Optional. Raises the GitHub API rate limit for repo import (60/hr -> 5000/hr).
GITHUB_TOKEN=
